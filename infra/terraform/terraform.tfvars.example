# Copy to a local, ignored terraform.tfvars file. This example deliberately
# contains placeholders and must be reviewed for the target subscription.
location    = "westeurope"
environment = "integration"

# Object IDs of Entra groups—not individual users—with administrative access to
# the private AKS API. Obtain them from the approved identity inventory.
aks_admin_group_object_ids = [
  "00000000-0000-0000-0000-000000000000",
]

# Temporal uses a private, zone-redundant PostgreSQL Flexible Server. Supply
# the administrator password at execution time through the approved secret
# runner, for example TF_VAR_temporal_postgresql_administrator_password; never
# add it to this file.
temporal_postgresql_administrator_login       = "eip_temporal_admin"
temporal_postgresql_primary_availability_zone = "1"
temporal_postgresql_standby_availability_zone = "2"
